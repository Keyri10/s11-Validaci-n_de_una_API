{
  "info": {
    "name": "S11 API Cafetería",
    "description": "Doce casos de la matriz S11. Cada request reinicia los datos de prueba y no depende de un id de una ejecución anterior.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01-Paginacion",
      "item": [
        {
          "name": "[S11-09] Listar productos con paginación válida",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/productos?page=1&limit=2"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.environment.get(\"baseUrl\");",
                  "pm.sendRequest({",
                  "  url: baseUrl + \"/api/test/reset\",",
                  "  method: \"POST\",",
                  "  header: { \"Content-Type\": \"application/json\" },",
                  "  body: { mode: \"raw\", raw: \"{}\" }",
                  "}, function (err, res) {",
                  "  if (err) throw err;",
                  "  if (res.code !== 200) throw new Error(\"No se pudieron reiniciar los datos.\");",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const page = pm.response.json();",
                  "",
                  "pm.test(\"S11-09 la primera página trae dos productos y el total\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(page.page).to.eql(1);",
                  "  pm.expect(page.limit).to.eql(2);",
                  "  pm.expect(page.total).to.eql(4);",
                  "  pm.expect(page.count).to.eql(2);",
                  "  pm.expect(page.data).to.have.lengthOf(2);",
                  "  pm.expect(page.data[0].name).to.eql(\"Café Americano\");",
                  "  pm.expect(page.data[1].name).to.eql(\"Cappuccino\");",
                  "});",
                  "",
                  "pm.sendRequest(pm.environment.get(\"baseUrl\") + \"/api/productos?page=2&limit=2\", function (err, res) {",
                  "  pm.test(\"S11-09 la segunda página trae el resto del menú\", function () {",
                  "    pm.expect(err).to.eql(null);",
                  "    const body = res.json();",
                  "    pm.expect(res.code).to.eql(200);",
                  "    pm.expect(body.page).to.eql(2);",
                  "    pm.expect(body.count).to.eql(2);",
                  "    pm.expect(body.total).to.eql(4);",
                  "    pm.expect(body.data[0].name).to.eql(\"Latte\");",
                  "    pm.expect(body.data[1].name).to.eql(\"Pastel de chocolate\");",
                  "  });",
                  "});",
                  "",
                  "pm.sendRequest(pm.environment.get(\"baseUrl\") + \"/api/productos?page=3&limit=2\", function (err, res) {",
                  "  pm.test(\"S11-09 una página fuera de rango llega vacía y conserva el total\", function () {",
                  "    pm.expect(err).to.eql(null);",
                  "    const body = res.json();",
                  "    pm.expect(res.code).to.eql(200);",
                  "    pm.expect(body.page).to.eql(3);",
                  "    pm.expect(body.limit).to.eql(2);",
                  "    pm.expect(body.total).to.eql(4);",
                  "    pm.expect(body.count).to.eql(0);",
                  "    pm.expect(body.data).to.eql([]);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[S11-10] Rechazar paginación inválida",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/productos?page=0&limit=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"S11-10 rechaza una página menor que 1\", function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error).to.eql(\"La página debe ser un entero mayor o igual que 1.\");",
                  "});",
                  "",
                  "pm.sendRequest(pm.environment.get(\"baseUrl\") + \"/api/productos?page=1&limit=0\", function (err, res) {",
                  "  pm.test(\"S11-10 rechaza un límite en cero\", function () {",
                  "    pm.expect(err).to.eql(null);",
                  "    pm.expect(res.code).to.eql(400);",
                  "    pm.expect(res.json().error).to.eql(\"El límite debe ser un entero entre 1 y 20.\");",
                  "  });",
                  "});",
                  "",
                  "pm.sendRequest(pm.environment.get(\"baseUrl\") + \"/api/productos?page=1&limit=21\", function (err, res) {",
                  "  pm.test(\"S11-10 rechaza un límite mayor que 20\", function () {",
                  "    pm.expect(err).to.eql(null);",
                  "    pm.expect(res.code).to.eql(400);",
                  "    pm.expect(res.json().error).to.eql(\"El límite debe ser un entero entre 1 y 20.\");",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02-Autenticacion",
      "item": [
        {
