                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{ \"productId\": 1, \"quantity\": 1 }]\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.environment.get(\"baseUrl\");",
                  "pm.sendRequest({",
                  "  url: baseUrl + \"/api/test/reset\",",
                  "  method: \"POST\",",
                  "  header: { \"Content-Type\": \"application/json\" },",
                  "  body: { mode: \"raw\", raw: \"{}\" }",
                  "}, function (err, res) {",
                  "  if (err) throw err;",
                  "  if (res.code !== 200) throw new Error(\"No se pudieron reiniciar los datos.\");",
                  "});"
