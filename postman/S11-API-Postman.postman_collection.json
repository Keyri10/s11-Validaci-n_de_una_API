        {
          "name": "[S11-07] Negar acceso a un pedido ajeno",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{unauthorizedToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/pedidos/{{orderId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.environment.get(\"baseUrl\");",
                  "pm.sendRequest({",
                  "  url: baseUrl + \"/api/test/reset\",",
                  "  method: \"POST\",",
                  "  header: { \"Content-Type\": \"application/json\" },",
                  "  body: { mode: \"raw\", raw: \"{}\" }",
                  "}, function (err, res) {",
                  "  if (err) throw err;",
                  "  if (res.code !== 200) throw new Error(\"No se pudieron reiniciar los datos.\");",
                  "  pm.sendRequest({",
                  "    url: baseUrl + \"/api/pedidos\",",
                  "    method: \"POST\",",
                  "    header: {",
                  "      \"Content-Type\": \"application/json\",",
                  "      Authorization: \"Bearer \" + pm.environment.get(\"authToken\")",
                  "    },",
                  "    body: {",
                  "      mode: \"raw\",",
                  "      raw: JSON.stringify({ items: [{ productId: 1, quantity: 1 }] })",
                  "    }",
                  "  }, function (err2, created) {",
                  "    if (err2) throw err2;",
                  "    if (created.code !== 201) throw new Error(\"No se pudo preparar el pedido: \" + created.text());",
                  "    pm.collectionVariables.set(\"orderId\", String(created.json().id));",
                  "  });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"S11-07 niega el pedido a otro usuario\", function () {",
                  "  pm.response.to.have.status(403);",
                  "  pm.expect(pm.response.json().error).to.eql(\"No puedes consultar un pedido de otro usuario.\");",
                  "});",
                  "",
                  "pm.sendRequest({",
                  "  url: pm.environment.get(\"baseUrl\") + \"/api/pedidos/\" + pm.collectionVariables.get(\"orderId\"),",
                  "  method: \"GET\",",
                  "  header: { Authorization: \"Bearer \" + pm.environment.get(\"authToken\") }",
                  "}, function (err, res) {",
                  "  pm.test(\"S11-07 el pedido sí existe para su dueño\", function () {",
                  "    pm.expect(err).to.eql(null);",
                  "    pm.expect(res.code).to.eql(200);",
                  "    pm.expect(res.json().owner).to.eql(pm.environment.get(\"authorizedUser\"));",
                  "    pm.expect(res.json().id).to.eql(Number(pm.collectionVariables.get(\"orderId\")));",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
