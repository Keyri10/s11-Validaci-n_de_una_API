              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{ \"productId\": 1, \"quantity\": 1 }]\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.environment.get(\"baseUrl\");",
                  "pm.sendRequest({",
                  "  url: baseUrl + \"/api/test/reset\",",
                  "  method: \"POST\",",
                  "  header: { \"Content-Type\": \"application/json\" },",
                  "  body: { mode: \"raw\", raw: \"{}\" }",
                  "}, function (err, res) {",
                  "  if (err) throw err;",
                  "  if (res.code !== 200) throw new Error(\"No se pudieron reiniciar los datos.\");",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"S11-01 crea el pedido del usuario autorizado\", function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(body.id).to.be.a(\"number\");",
                  "  pm.expect(body.code).to.eql(\"ORD-\" + body.id);",
                  "  pm.expect(body.status).to.eql(\"confirmed\");",
                  "  pm.expect(body.owner).to.eql(pm.environment.get(\"authorizedUser\"));",
                  "  pm.expect(body.totalCents).to.eql(3500);",
                  "  pm.expect(body.total).to.eql(\"35.00\");",
                  "  pm.expect(body.items).to.have.lengthOf(1);",
                  "  pm.expect(body.items[0].productId).to.eql(1);",
                  "  pm.expect(body.items[0].name).to.eql(\"Café Americano\");",
                  "});",
                  "",
                  "pm.sendRequest(pm.environment.get(\"baseUrl\") + \"/api/orders\", function (err, res) {",
                  "  pm.test(\"S11-01 el pedido queda guardado\", function () {",
                  "    pm.expect(err).to.eql(null);",
                  "    pm.expect(res.code).to.eql(200);",
                  "    pm.expect(res.json()).to.have.lengthOf(1);",
                  "    pm.expect(res.json()[0].id).to.eql(body.id);",
                  "    pm.expect(res.json()[0].totalCents).to.eql(3500);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[S11-02] Verificar el pedido y el stock",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/pedidos/{{orderId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.environment.get(\"baseUrl\");",
                  "pm.sendRequest({",
                  "  url: baseUrl + \"/api/test/reset\",",
                  "  method: \"POST\",",
                  "  header: { \"Content-Type\": \"application/json\" },",
                  "  body: { mode: \"raw\", raw: \"{}\" }",
                  "}, function (err, res) {",
                  "  if (err) throw err;",
                  "  if (res.code !== 200) throw new Error(\"No se pudieron reiniciar los datos.\");",
                  "  pm.sendRequest({",
                  "    url: baseUrl + \"/api/pedidos\",",
                  "    method: \"POST\",",
                  "    header: {",
                  "      \"Content-Type\": \"application/json\",",
                  "      Authorization: \"Bearer \" + pm.environment.get(\"authToken\")",
                  "    },",
                  "    body: {",
                  "      mode: \"raw\",",
                  "      raw: JSON.stringify({",
                  "        items: [",
                  "          { productId: 1, quantity: 1 },",
                  "          { productId: 2, quantity: 2 }",
                  "        ]",
                  "      })",
                  "    }",
                  "  }, function (err2, created) {",
                  "    if (err2) throw err2;",
                  "    if (created.code !== 201) throw new Error(\"No se pudo preparar el pedido: \" + created.text());",
                  "    pm.collectionVariables.set(\"orderId\", String(created.json().id));",
                  "  });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"S11-02 el pedido guardado tiene el total calculado\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body.id).to.eql(Number(pm.collectionVariables.get(\"orderId\")));",
                  "  pm.expect(body.totalCents).to.eql(12500);",
                  "  pm.expect(body.total).to.eql(\"125.00\");",
                  "  pm.expect(body.status).to.eql(\"confirmed\");",
                  "  pm.expect(body.owner).to.eql(pm.environment.get(\"authorizedUser\"));",
                  "  pm.expect(body.items).to.have.lengthOf(2);",
                  "  pm.expect(body.items.map(function (item) { return item.productId; })).to.have.members([1, 2]);",
                  "});",
                  "",
                  "pm.sendRequest(pm.environment.get(\"baseUrl\") + \"/api/products\", function (err, res) {",
                  "  pm.test(\"S11-02 el stock bajó según lo pedido\", function () {",
                  "    pm.expect(err).to.eql(null);",
                  "    const products = res.json();",
                  "    const americano = products.find(function (item) { return item.name === \"Café Americano\"; });",
                  "    const cappuccino = products.find(function (item) { return item.name === \"Cappuccino\"; });",
                  "    pm.expect(americano.stock).to.eql(19);",
                  "    pm.expect(cappuccino.stock).to.eql(13);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
