    {
      "name": "04-Idempotencia",
      "item": [
        {
          "name": "[S11-11] Repetir el cambio de estado",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/pedidos/{{orderId}}/estado",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"listo\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.environment.get(\"baseUrl\");",
                  "pm.sendRequest({",
                  "  url: baseUrl + \"/api/test/reset\",",
                  "  method: \"POST\",",
                  "  header: { \"Content-Type\": \"application/json\" },",
                  "  body: { mode: \"raw\", raw: \"{}\" }",
                  "}, function (err, res) {",
                  "  if (err) throw err;",
                  "  if (res.code !== 200) throw new Error(\"No se pudieron reiniciar los datos.\");",
                  "  pm.sendRequest({",
                  "    url: baseUrl + \"/api/pedidos\",",
                  "    method: \"POST\",",
                  "    header: {",
                  "      \"Content-Type\": \"application/json\",",
                  "      Authorization: \"Bearer \" + pm.environment.get(\"authToken\")",
                  "    },",
                  "    body: {",
                  "      mode: \"raw\",",
                  "      raw: JSON.stringify({ items: [{ productId: 1, quantity: 1 }] })",
                  "    }",
                  "  }, function (err2, created) {",
                  "    if (err2) throw err2;",
                  "    if (created.code !== 201) throw new Error(\"No se pudo preparar el pedido: \" + created.text());",
                  "    pm.collectionVariables.set(\"orderId\", String(created.json().id));",
                  "  });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const first = pm.response.json();",
                  "const baseUrl = pm.environment.get(\"baseUrl\");",
                  "const orderId = pm.collectionVariables.get(\"orderId\");",
                  "",
                  "pm.test(\"S11-11 la primera asignación deja el pedido en listo\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(first.status).to.eql(\"listo\");",
                  "  pm.expect(first.totalCents).to.eql(3500);",
                  "  pm.expect(first.id).to.eql(Number(orderId));",
                  "});",
                  "",
                  "pm.sendRequest({",
                  "  url: baseUrl + \"/api/pedidos/\" + orderId + \"/estado\",",
                  "  method: \"PUT\",",
                  "  header: {",
                  "    \"Content-Type\": \"application/json\",",
                  "    Authorization: \"Bearer \" + pm.environment.get(\"authToken\")",
                  "  },",
                  "  body: { mode: \"raw\", raw: JSON.stringify({ status: \"listo\" }) }",
                  "}, function (err, secondRes) {",
                  "  pm.test(\"S11-11 la repetición responde el mismo estado y el mismo total\", function () {",
                  "    pm.expect(err).to.eql(null);",
                  "    const second = secondRes.json();",
                  "    pm.expect(secondRes.code).to.eql(200);",
                  "    pm.expect(second.status).to.eql(\"listo\");",
                  "    pm.expect(second.totalCents).to.eql(first.totalCents);",
                  "    pm.expect(second.id).to.eql(first.id);",
                  "    pm.expect(second.items).to.have.lengthOf(1);",
                  "  });",
                  "",
                  "  pm.sendRequest({",
                  "    url: baseUrl + \"/api/pedidos/\" + orderId,",
                  "    method: \"GET\",",
                  "    header: { Authorization: \"Bearer \" + pm.environment.get(\"authToken\") }",
                  "  }, function (err2, savedRes) {",
                  "    pm.test(\"S11-11 el efecto final sigue en listo\", function () {",
                  "      pm.expect(err2).to.eql(null);",
                  "      const saved = savedRes.json();",
                  "      pm.expect(savedRes.code).to.eql(200);",
                  "      pm.expect(saved.status).to.eql(\"listo\");",
                  "      pm.expect(saved.totalCents).to.eql(3500);",
                  "      pm.expect(saved.items).to.have.lengthOf(1);",
                  "      pm.expect(saved.items[0].productId).to.eql(1);",
                  "    });",
                  "",
                  "    pm.sendRequest(baseUrl + \"/api/products\", function (err3, productsRes) {",
                  "      pm.test(\"S11-11 repetir el estado no vuelve a descontar stock\", function () {",
                  "        pm.expect(err3).to.eql(null);",
                  "        const americano = productsRes.json().find(function (item) { return item.id === 1; });",
                  "        pm.expect(americano.stock).to.eql(19);",
                  "      });",
                  "",
                  "      pm.sendRequest(baseUrl + \"/api/orders\", function (err4, ordersRes) {",
                  "        pm.test(\"S11-11 no se creó otro pedido\", function () {",
                  "          pm.expect(err4).to.eql(null);",
                  "          pm.expect(ordersRes.json()).to.have.lengthOf(1);",
                  "        });",
                  "      });",
                  "    });",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05-Esquemas",
      "item": [
        {
          "name": "[S11-12] Validar esquemas de éxito y error",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/pedidos/{{orderId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.environment.get(\"baseUrl\");",
                  "pm.sendRequest({",
                  "  url: baseUrl + \"/api/test/reset\",",
                  "  method: \"POST\",",
                  "  header: { \"Content-Type\": \"application/json\" },",
                  "  body: { mode: \"raw\", raw: \"{}\" }",
                  "}, function (err, res) {",
                  "  if (err) throw err;",
                  "  if (res.code !== 200) throw new Error(\"No se pudieron reiniciar los datos.\");",
                  "  pm.sendRequest({",
                  "    url: baseUrl + \"/api/pedidos\",",
                  "    method: \"POST\",",
                  "    header: {",
                  "      \"Content-Type\": \"application/json\",",
                  "      Authorization: \"Bearer \" + pm.environment.get(\"authToken\")",
                  "    },",
                  "    body: {",
                  "      mode: \"raw\",",
                  "      raw: JSON.stringify({ items: [{ productId: 1, quantity: 1 }] })",
                  "    }",
                  "  }, function (err2, created) {",
                  "    if (err2) throw err2;",
                  "    if (created.code !== 201) throw new Error(\"No se pudo preparar el pedido: \" + created.text());",
                  "    pm.collectionVariables.set(\"orderId\", String(created.json().id));",
                  "  });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"S11-12 el pedido cumple el esquema de éxito\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body).to.have.keys(\"id\", \"code\", \"totalCents\", \"total\", \"status\", \"owner\", \"createdAt\", \"items\");",
                  "  pm.expect(Number.isInteger(body.id)).to.eql(true);",
                  "  pm.expect(body.code).to.match(/^ORD-\\d+$/);",
                  "  pm.expect(Number.isInteger(body.totalCents)).to.eql(true);",
                  "  pm.expect(body.total).to.match(/^\\d+\\.\\d{2}$/);",
                  "  pm.expect([\"confirmed\", \"preparando\", \"listo\"]).to.include(body.status);",
                  "  pm.expect(body.owner).to.be.a(\"string\");",
                  "  pm.expect(body.createdAt).to.match(/^\\d{4}-\\d{2}-\\d{2}T/);",
                  "  pm.expect(body.items).to.be.an(\"array\").that.is.not.empty;",
                  "  body.items.forEach(function (item) {",
                  "    pm.expect(item).to.have.keys(\"productId\", \"name\", \"quantity\", \"unitPriceCents\", \"subtotalCents\");",
                  "    pm.expect(Number.isInteger(item.productId)).to.eql(true);",
                  "    pm.expect(item.name).to.be.a(\"string\");",
                  "    pm.expect(item.quantity, \"quantity\").to.be.a(\"number\");",
                  "    pm.expect(Number.isInteger(item.quantity), \"quantity entero\").to.eql(true);",
                  "    pm.expect(item.quantity).to.be.above(0);",
                  "    pm.expect(Number.isInteger(item.unitPriceCents)).to.eql(true);",
                  "    pm.expect(Number.isInteger(item.subtotalCents)).to.eql(true);",
                  "  });",
                  "});",
                  "",
                  "const baseUrl = pm.environment.get(\"baseUrl\");",
                  "",
                  "pm.sendRequest(baseUrl + \"/api/productos?page=1&limit=5\", function (err, pageRes) {",
                  "  pm.test(\"S11-12 la página de productos cumple el esquema\", function () {",
                  "    pm.expect(err).to.eql(null);",
                  "    pm.expect(pageRes.code).to.eql(200);",
                  "    const page = pageRes.json();",
                  "    pm.expect(page).to.have.keys(\"data\", \"page\", \"limit\", \"total\", \"count\");",
                  "    pm.expect(Number.isInteger(page.page)).to.eql(true);",
                  "    pm.expect(Number.isInteger(page.limit)).to.eql(true);",
                  "    pm.expect(Number.isInteger(page.total)).to.eql(true);",
                  "    pm.expect(Number.isInteger(page.count)).to.eql(true);",
                  "    pm.expect(page.count).to.eql(page.data.length);",
                  "    pm.expect(page.data).to.be.an(\"array\").that.is.not.empty;",
                  "    page.data.forEach(function (product) {",
                  "      pm.expect(product).to.have.keys(\"id\", \"name\", \"priceCents\", \"stock\");",
                  "      pm.expect(Number.isInteger(product.id)).to.eql(true);",
                  "      pm.expect(product.name).to.be.a(\"string\");",
                  "      pm.expect(Number.isInteger(product.priceCents)).to.eql(true);",
                  "      pm.expect(Number.isInteger(product.stock)).to.eql(true);",
                  "    });",
                  "  });",
                  "});",
                  "",
                  "pm.sendRequest(baseUrl + \"/api/pedidos/\" + pm.collectionVariables.get(\"orderId\"), function (err, errorRes) {",
                  "  pm.test(\"S11-12 el error cumple el esquema\", function () {",
                  "    pm.expect(err).to.eql(null);",
                  "    pm.expect(errorRes.code).to.eql(401);",
                  "    const errorBody = errorRes.json();",
                  "    pm.expect(errorBody).to.have.keys(\"error\");",
                  "    pm.expect(errorBody.error).to.be.a(\"string\");",
                  "    pm.expect(errorBody.error.length).to.be.above(0);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
